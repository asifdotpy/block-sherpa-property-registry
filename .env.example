# ── ROOT .env — for Hardhat Amoy deployment (project root, NOT frontend/) ──
# Copy this file to ".env" in the SAME directory and fill in your values.
# This file is gitignored (.env) — it never gets committed or pushed.

# Your AMOY TESTNET wallet private key (0x...).
# USE A SEPARATE TEST WALLET — never your mainnet funds.
# Get one: create a fresh account in MetaMask, export its private key.
PRIVATE_KEY=0xYOUR_AMOY_TEST_WALLET_PRIVATE_KEY

# Polygon Amoy public RPC (no key needed). The config falls back to this if unset.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# ── FAUCET STEP (do this AFTER setting PRIVATE_KEY, BEFORE deploy) ──
# 1. Run:  npx hardhat run scripts/print-address.js --network amoy
#    -> prints the wallet address derived from PRIVATE_KEY.
# 2. Go to https://faucet.polygon.technology
# 3. Select "Polygon Amoy" and paste that address -> claim test POL.
# 4. Wait ~30-60s, then deploy:
#    npx hardhat run scripts/deploy.js --network amoy
